# Supabase — copy to .env.local and fill in your values
# Get these from your Supabase project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# WP Staging app URL — enables Upcoming tab to show sites queued for staging
MU_STAGING_URL=https://your-mu-wp-staging.up.railway.app

# App URL — used for OAuth redirect URIs (no trailing slash)
# APP_URL is used server-side (runtime, not baked at build time)
# NEXT_PUBLIC_APP_URL is used client-side (baked at build time)
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cron trigger protection — set this in production and in GitHub repo secrets
# Leave unset locally so curl -X POST http://localhost:3000/api/cron/trigger works without auth
CRON_SECRET=
