# Supabase — copy to .env.local and fill in your values
# Get these from your Supabase project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Cron trigger protection — set this in production and in GitHub repo secrets
# Leave unset locally so curl -X POST http://localhost:3000/api/cron/trigger works without auth
CRON_SECRET=
